{
  "functions": {
    "api/report.js": {
      "maxDuration": 60
    },
    "api/freeze.js": {
      "maxDuration": 60
    },
    "api/snapshot.js": {
      "maxDuration": 60
    },
    "api/aweber-callback.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/snapshot",
      "schedule": "0 22 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "nicoya-mre-reports.vercel.app"
        }
      ],
      "destination": "https://mre-acquisition.vercel.app/rapports/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nicoya-mre-reports.vercel.app"
        }
      ],
      "destination": "https://mre-acquisition.vercel.app/rapports/:path*",
      "permanent": false
    },
    {
      "source": "/acquisition",
      "destination": "/acquisition/",
      "permanent": false
    },
    {
      "source": "/rapports",
      "destination": "/rapports/",
      "permanent": false
    },
    {
      "source": "/challenge.html",
      "destination": "/acquisition/challenge.html",
      "permanent": false
    },
    {
      "source": "/bilans",
      "destination": "/bilans/mre5/",
      "permanent": false
    },
    {
      "source": "/bilans/",
      "destination": "/bilans/mre5/",
      "permanent": false
    }
  ]
}